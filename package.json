{
  "name": "browser-agent-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A safety-gated Chrome side panel agent for page and YouTube analysis.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.2.7",
    "@types/node": "26.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
